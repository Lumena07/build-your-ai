# Kept on the server / deployment platform only. Never copy these values into
# runtime-config.js or any browser-delivered file.
RUNPOD_API_KEY=replace-with-a-runpod-api-key
RUNPOD_TRAINING_ENDPOINT_ID=replace-with-training-endpoint-id
RUNPOD_INFERENCE_ENDPOINT_ID=replace-with-inference-endpoint-id
BASE_MODEL_ID=replace-with-an-approved-open-weight-instruct-model
ALLOWED_ORIGIN=https://your-product-domain.example
DATABASE_PATH=/data/build-your-ai.db
# In development only, a comma-separated allow-list may be used.
# ALLOWED_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
