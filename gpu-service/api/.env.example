# This file stays on your own computer. Never put this key in the website or GitHub.
OPENAI_API_KEY=paste-your-key-here
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE=marin

# Allows the local website (opened as a file) and a normal local web server to talk to Eve.
ALLOWED_ORIGIN=null,http://127.0.0.1:8000,http://localhost:8000
